;;; stdlib/s7/case/lib.lext
(define *s7-dir* (string-append (or (getenv "LEXT_HOME") ".") "/stdlib/s7/"))

;; Define dummy *libc* environment for load-time safety
(unless (defined? '*libc*)
  (load (string-append *s7-dir* "libc.scm") (rootlet)))

(load (string-append *s7-dir* "case.scm") (curlet))

(varlet (rootlet) 'case* ((curlet) 'case*))


