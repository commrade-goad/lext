;;; stdlib/s7/reactive/lib.lext
(define *s7-dir* (string-append (or (getenv "LEXT_HOME") ".") "/stdlib/s7/"))

;; Define dummy *libc* environment for load-time safety
(unless (defined? '*libc*)
  (load (string-append *s7-dir* "libc.scm") (rootlet)))

(load (string-append *s7-dir* "reactive.scm") (curlet))

(for-each
  (lambda (binding)
    (let ((sym (car binding)))
      (unless (memq sym '(a b x test xyzzy))
        (varlet (rootlet) sym (cdr binding)))))
  (let->list (curlet)))
