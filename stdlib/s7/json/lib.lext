;;; stdlib/s7/json/lib.lext
(define *s7-dir* (string-append (or (getenv "LEXT_HOME") ".") "/stdlib/s7/"))

;; Define dummy *libc* environment for load-time safety
(unless (defined? '*libc*)
  (load (string-append *s7-dir* "libc.scm") (rootlet)))

;; Define custom reverse inside the module environment to support reversing lets/environments
(define (reverse obj)
  (if (let? obj)
      (#_reverse (let->list obj))
      (#_reverse obj)))

(load (string-append *s7-dir* "json.scm") (curlet))

;; Override s7->json to add support for boolean and null serialization
(define json-s7->json-orig s7->json)
(define* (s7->json obj (port (current-output-port)))
  (cond ((eq? obj #t) (display "true" port))
        ((eq? obj #f) (display "false" port))
        ((null? obj)  (display "null" port))
        (else         (json-s7->json-orig obj port))))


