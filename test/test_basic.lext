(use "stdlib/libnob" "stdlib/basic" "stdlib/c")

(open-namespace "basic")
(open-namespace "c")

(display "=== 1. Testing Type Translation & Declarations ===\n")
(display (format #f "Translated (* t): ~A\n" (translate-ffi-type '(* t))))
(display (format #f "Translated (* Nob_Cmd): ~A\n" (translate-ffi-type '(* Nob_Cmd))))

(define-c-struct My_Inner
  (val int)
  (flag char))

(define-c-struct My_Outer
  (inner My_Inner)
  (ptr (* My_Inner))
  (name string))

(display (format #f "c-size My_Inner: ~A (expected: 8 due to alignment/padding)\n" (c-size 'My_Inner)))
(display (format #f "c-size My_Outer: ~A (expected: 24 due to alignment/padding)\n" (c-size 'My_Outer)))

(display "\n=== 2. Testing Memory Sandbox Allocation & @ / c-set! ===\n")
(with-heap-alloc (obj My_Outer)
  (c.= obj.inner.val 42)
  (c.= obj.inner.flag 120)
  (display (format #f "Read obj.inner.val: ~A\n" (c.@ obj.inner.val)))
  (display (format #f "Read obj.inner.flag: ~A\n" (integer->char (c.@ obj.inner.flag)))))

(display "\n=== 3. Testing with-c-string, with-c-array, with-c-string-array ===\n")
(with-c-string (s "Hello from s7 Basic!")
  (display (format #f "C string read: ~S\n" (c-string-from-ptr s))))

(with-c-array (arr int '(10 20 30 40))
  (display (format #f "Array [0]: ~A\n" (c.@ arr.0)))
  (display (format #f "Array [2]: ~A\n" (c.@ arr.2))))

(with-c-string-array (args '("arg1" "arg2" "arg3"))
  (display (format #f "String array [0]: ~A\n" (c-string-from-ptr (c.@ args.0))))
  (display (format #f "String array [1]: ~A\n" (c-string-from-ptr (c.@ args.1))))
  (display (format #f "String array [2]: ~A\n" (c-string-from-ptr (c.@ args.2))))
  (display (format #f "String array as list: ~S\n" (c-string-array->list args))))

(display "\n=== 4. Testing capture macro ===\n")
(let ((captured (capture
                  (display "First stdout write.\n")
                  (display "Second stdout write.\n"))))
  (display (format #f "Captured string: ~S\n" captured)))

(display "\n=== 5. Testing Enum macro ===\n")
(define-c-enum my-states
  :state-pending
  :state-active
  (state-error -100))

(display (format #f "state-pending: ~A\n" state-pending))
(display (format #f "state-active: ~A\n" state-active))
(display (format #f "state-error: ~A\n" state-error))

(display "\n=== 6. Testing *platform* variable ===\n")
(display (format #f "Platform: ~S\n" *platform*))

(display "\n=== 7. Testing open-namespace and use-namespace ===\n")

(display (format #f "After open-namespace c., malloc is defined: ~A\n" (defined? 'malloc)))
(display (format #f "After open-namespace c., free is defined: ~A\n" (defined? 'free)))
;; Verify standard protected operator is not overwritten
(display (format #f "After open-namespace, standard = is still original: ~A\n" (eq? = (symbol->value '= (rootlet)))))

;; Test use-namespace locally (scoped)
(use-namespace "libnob"
  (display (format #f "Inside use-namespace, log is defined: ~A\n" (defined? 'log)))
  (display (format #f "Inside use-namespace, cmd-new is defined: ~A\n" (defined? 'cmd-new))))

;; Verify that outside use-namespace, local bindings are not polluted/defined
(display (format #f "Outside use-namespace, log is defined: ~A\n" (defined? 'log)))
(display (format #f "Outside use-namespace, cmd-new is defined: ~A\n" (defined? 'cmd-new)))

(display "\n=== 8. Testing while, for, foreach Loop Constructs ===\n")
(display "Testing while:\n")
(let ((i 0))
  (while (< i 5)
    (display (format #f "  while: ~A\n" i))
    (set! i (+ i 1))))

(display "Testing for (range 0 to 5):\n")
(for (i 0 5)
  (display (format #f "  for: ~A\n" i)))

(display "Testing for with step (10 to 0 step -2):\n")
(for (i 10 0 -2)
  (display (format #f "  for-step: ~A\n" i)))

(display "Testing foreach:\n")
(foreach (x '(apple orange banana))
  (display (format #f "  foreach: ~A\n" x)))

(display "\n=== 9. Testing ported Scheme and String utilities ===\n")
(let ((is-even? (lambda (x) (eqv? (modulo x 2) 0)))
      (lst '(1 2 3 4 5)))
  ;; check any/every
  (display (format #f "  any even?: ~A\n" (any is-even? lst)))
  (display (format #f "  every odd?: ~A\n" (every (lambda (x) (not (is-even? x))) lst)))
  ;; check filter/partition/find
  (display (format #f "  filter even: ~A\n" (filter is-even? lst)))
  (display (format #f "  partition even/odd: ~A\n" (partition is-even? lst)))
  (display (format #f "  find even > 3: ~A\n" (find (lambda (x) (and (is-even? x) (> x 3))) lst)))
  ;; check foldl/foldr
  (display (format #f "  foldl sum: ~A\n" (foldl + 0 lst)))
  (display (format #f "  foldr cons: ~A\n" (foldr cons '() lst)))
  ;; check take/drop/flatmap
  (display (format #f "  take 3: ~A\n" (take lst 3)))
  (display (format #f "  drop 3: ~A\n" (drop lst 3)))
  (display (format #f "  flatmap duplicate: ~A\n" (flatmap (lambda (x) (list x x)) '(a b))))
  ;; check empty?, iota, range, flatten, prog1, zip
  (display (format #f "  empty? '(): ~A\n" (empty? '())))
  (display (format #f "  empty? '(1): ~A\n" (empty? '(1))))
  (display (format #f "  iota 5: ~A\n" (iota 5)))
  (display (format #f "  range 5: ~A\n" (range 5)))
  (display (format #f "  range 1 5 2: ~A\n" (range 1 5 2)))
  (display (format #f "  range 5 0 -1: ~A\n" (range 5 0 -1)))
  (display (format #f "  flatten '((1 2) 3 (4)): ~A\n" (flatten '((1 2) 3 (4)))))
  (display (format #f "  prog1: ~A\n" (prog1 "first" (display "  (prog1 body ran)\n"))))
  (display (format #f "  zip: ~A\n" (zip '(1 2) '(a b))))
  ;; check count, remove, unzip, list-index, take-while, drop-while, list-tabulate, member?
  (display (format #f "  count even: ~A\n" (count is-even? lst)))
  (display (format #f "  remove even: ~A\n" (remove is-even? lst)))
  (display (format #f "  unzip: ~A\n" (unzip '((1 a) (2 b)))))
  (display (format #f "  list-index even: ~A\n" (list-index is-even? lst)))
  (display (format #f "  take-while < 3: ~A\n" (take-while (lambda (x) (< x 3)) lst)))
  (display (format #f "  drop-while < 3: ~A\n" (drop-while (lambda (x) (< x 3)) lst)))
  (display (format #f "  list-tabulate 4: ~A\n" (list-tabulate 4 (lambda (x) (* x 2)))))
  (display (format #f "  member? 3: ~A\n" (member? 3 lst)))
  (display (format #f "  member? 10: ~A\n" (member? 10 lst)))
  ;; check assoc-ref, assoc-set, assoc-remove
  (let ((al '((a . 1) (b . 2))))
    (display (format #f "  assoc-ref a: ~A\n" (assoc-ref al 'a)))
    (display (format #f "  assoc-ref c: ~A\n" (assoc-ref al 'c 3)))
    (display (format #f "  assoc-set c 3: ~A\n" (assoc-set al 'c 3)))
    (display (format #f "  assoc-set a 10: ~A\n" (assoc-set al 'a 10)))
    (display (format #f "  assoc-remove a: ~A\n" (assoc-remove al 'a))))
  ;; check string-trim/left/right, string-prefix?, string-suffix?, string-contains?, string-replace
  (display (format #f "  string-trim: ~S\n" (string-trim "  hello  ")))
  (display (format #f "  string-trim-left: ~S\n" (string-trim-left "  hello  ")))
  (display (format #f "  string-trim-right: ~S\n" (string-trim-right "  hello  ")))
  (display (format #f "  string-prefix? he: ~A\n" (string-prefix? "he" "hello")))
  (display (format #f "  string-suffix? lo: ~A\n" (string-suffix? "lo" "hello")))
  (display (format #f "  string-contains? ell: ~A\n" (string-contains? "hello" "ell")))
  (display (format #f "  string-replace l x: ~S\n" (string-replace "hello" "l" "x")))
  ;; check clamp, identity
  (display (format #f "  clamp 5 1 10: ~A\n" (clamp 5 1 10)))
  (display (format #f "  clamp 0 1 10: ~A\n" (clamp 0 1 10)))
  (display (format #f "  clamp 15 1 10: ~A\n" (clamp 15 1 10)))
  (display (format #f "  identity 42: ~A\n" (identity 42))))

(let ((parts (string-split "apple,orange,banana" ",")))
  (display (format #f "  string-split: ~A\n" parts))
  (display (format #f "  string-join: ~A\n" (string-join parts "-"))))
